# 빌드 컨텍스트 축소 — 아래는 이미지에 굽지 않는다(볼륨 마운트 또는 불필요).
.git/
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

# 시크릿 — compose의 env_file로만 주입한다.
.env
.env.*
!.env.example

# 수집·분석 산출물 (호스트 data/ 볼륨으로 들어온다)
data/
docs_cache/
*.duckdb
*.pkl

# 문서·작업기록·에이전트 자산 (실행에 불필요)
docs/
FINAL-REPORT/
images/
golden/
tests/
dev/
_workspace/
.claude/
.codex/
.superpowers/
.playwright-cli/
